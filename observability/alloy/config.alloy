// Grafana Alloy — core-node collector (PRD: hybrid egress).
// The bot exports OTLP here; Alloy derives RED from spans (spanmetrics),
// scrapes host metrics, and is the single egress to Grafana Cloud (holds the
// credential). The edge gateway stays OTLP-direct.

otelcol.receiver.otlp "in" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces  = [otelcol.connector.spanmetrics.red.input, otelcol.exporter.otlphttp.grafana.input]
		metrics = [otelcol.exporter.otlphttp.grafana.input]
		logs    = [otelcol.exporter.otlphttp.grafana.input]
	}
}

// RED (rate/errors/duration) derived from spans, split by command.outcome.
otelcol.connector.spanmetrics "red" {
	dimension {
		name = "command.outcome"
	}

	histogram {
		explicit { }
	}

	output {
		metrics = [otelcol.exporter.otlphttp.grafana.input]
	}
}

// Host metrics (RAM/CPU/swap) via node_exporter, routed into the OTLP pipeline
// so everything egresses through one endpoint and one credential. Paths point at
// the host filesystem mounted read-only by the compose service.
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/rootfs"
}

// Name the node, so alerts read instance=core instead of the Alloy container id.
discovery.relabel "host" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "instance"
		replacement  = "core"
	}
}

prometheus.scrape "host" {
	targets         = discovery.relabel.host.output
	forward_to      = [otelcol.receiver.prometheus.scraped.receiver]
	scrape_interval = "30s"
}

// Edge host metrics from its node-exporter, over the VCN private subnet (Oracle
// security list opens 9100 edge->core), like RabbitMQ below. Same job as the core
// so every node_* query covers both nodes, split by instance.
prometheus.scrape "edge_host" {
	targets         = [{"__address__" = sys.env("EDGE_NODE_METRICS_ADDR"), "instance" = "edge"}]
	forward_to      = [otelcol.receiver.prometheus.scraped.receiver]
	scrape_interval = "30s"
	job_name        = "integrations/unix"
}

// RabbitMQ queue metrics from the edge, scraped over the VCN private subnet
// (Oracle security list opens 15692 edge->core). /metrics/per-object gives
// per-queue depth. Empty RABBITMQ_METRICS_ADDR = the scrape target is unset and
// the job simply reports down, no host impact.
prometheus.scrape "rabbitmq" {
	targets         = [{"__address__" = sys.env("RABBITMQ_METRICS_ADDR"), "instance" = "edge-rabbitmq"}]
	metrics_path    = "/metrics/per-object"
	forward_to      = [otelcol.receiver.prometheus.scraped.receiver]
	scrape_interval = "30s"
	job_name        = "rabbitmq"
}

otelcol.receiver.prometheus "scraped" {
	output {
		metrics = [otelcol.exporter.otlphttp.grafana.input]
	}
}

otelcol.exporter.otlphttp "grafana" {
	client {
		endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")

		headers = {
			"Authorization" = sys.env("GRAFANA_CLOUD_OTLP_AUTH"),
		}
	}
}
