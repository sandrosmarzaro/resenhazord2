          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (span_name) (increase(traces_span_metrics_duration_milliseconds_sum{span_name!~\"GET /health.*\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (span_name) (increase(span_self_time_milliseconds_sum{span_name!~\"GET /health.*\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (span_name) (increase(span_self_time_milliseconds_sum{span_name!~\"GET /health.*\"}[$__range])) / sum by (span_name) (increase(traces_span_metrics_duration_milliseconds_sum{span_name!~\"GET /health.*\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "span_name": "span", "Value #A": "total", "Value #B": "self", "Value #C": "self share" },
            "indexByName": { "span_name": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3 }
          }
        }
      ]
