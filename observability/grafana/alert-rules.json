  {
    "uid": "rz2-upstream-failing",
    "title": "Upstream failing",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "0s",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "An upstream failed 5+ times in an hour",
      "description": "One third-party API keeps failing (upstream.failures, labelled by upstream). A fallback may be hiding it from users, so check the nightly contracts too."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum by (upstream) (increase(upstream_failures_total[1h]))"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": { "refId": "C", "type": "math", "expression": "$A >= 5" }
      }
    ]
  },
  {
    "uid": "rz2-event-loop-lag",
    "title": "Event loop lagging",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "10m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "The core's event loop is waking 500ms+ late",
      "description": "p99 event loop lag over 500ms for 10 minutes: CPU work is running on the loop and holding every command back."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 300, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(event_loop_lag_milliseconds_bucket[5m])))"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": { "refId": "C", "type": "math", "expression": "$A > 500" }
      }
    ]
  }
]
