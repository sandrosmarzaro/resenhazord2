[
  {
    "uid": "rz2-core-memory-low",
    "title": "Node memory low",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "{{ $labels.instance }} available memory below 10%",
      "description": "The documented OOM/host-freeze risk on the 1 GB nodes."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "lt", "params": [10] } }]
        }
      }
    ]
  },
  {
    "uid": "rz2-swap-thrashing",
    "title": "Swap thrashing",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "10m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "{{ $labels.instance }} swap above 80%",
      "description": "Sustained swap pressure precedes the freeze."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "100 * (1 - node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes)"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "gt", "params": [80] } }]
        }
      }
    ]
  },
  {
    "uid": "rz2-dead-letters-rising",
    "title": "Dead-letters rising",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "0s",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "More than 5 commands dead-lettered in 15m",
      "description": "Commands giving up after the retry ladder."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 900, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum(increase(command_dlq_total[15m]))"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "gt", "params": [5] } }]
        }
      }
    ]
  },
  {
    "uid": "rz2-commands-backlog",
    "title": "Commands backlog",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "More than 100 commands waiting in the queue",
      "description": "The bot is falling behind or stalled consuming."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum(rabbitmq_queue_messages_ready{queue=\"commands\"})"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "gt", "params": [100] } }]
        }
      }
    ]
  },
  {
    "uid": "rz2-agent-provider-down",
    "title": "Agent provider down",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "10m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "Most NL mappings hit no working LLM provider",
      "description": "Direct commands still work, but the agent is effectively down."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum(rate(agent_mappings_total{agent_outcome=\"unavailable\"}[10m])) / clamp_min(sum(rate(agent_mappings_total[10m])), 0.0001)"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "gt", "params": [0.5] } }]
        }
      }
    ]
  },
  {
    "uid": "rz2-scrape-target-down",
    "title": "Scrape target down",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "5m",
    "noDataState": "Alerting",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "{{ $labels.instance }} stopped reporting metrics",
      "description": "The core Alloy scrapes both nodes, so no data at all means the core or its egress is down and every other alert went blind."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "up"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "lt", "params": [1] } }]
        }
      }
    ]
  },
  {
    "uid": "rz2-slo-availability-fast-burn",
    "title": "SLO availability fast burn",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "2m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "Commands are failing 14.4x faster than the 95% SLO allows",
      "description": "Over 72% of command runs failed (external or unexpected errors) in both the last hour and the last 5 minutes. At this rate the 30-day error budget is gone in about two days. Needs 3+ runs in the hour."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\", status_code=\"STATUS_CODE_ERROR\"}[1h])) / sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\"}[1h]))"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 300, "to": 0 },
        "model": {
          "refId": "B",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\"}[5m]))"
        }
      },
      {
        "refId": "V",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "model": {
          "refId": "V",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\"}[1h]))"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": { "refId": "C", "type": "math", "expression": "$A > 0.72 && $B > 0.72 && $V >= 3" }
      }
    ]
  },
  {
    "uid": "rz2-slo-availability-slow-burn",
    "title": "SLO availability slow burn",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "15m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "Commands are failing 6x faster than the 95% SLO allows",
      "description": "Over 30% of command runs failed in both the last 6 hours and the last 30 minutes. At this rate the 30-day error budget lasts about five days. Needs 5+ runs in the 6 hours."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 21600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\", status_code=\"STATUS_CODE_ERROR\"}[6h])) / sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\"}[6h]))"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 1800, "to": 0 },
        "model": {
          "refId": "B",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\", status_code=\"STATUS_CODE_ERROR\"}[30m])) / sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\"}[30m]))"
        }
      },
      {
        "refId": "V",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 21600, "to": 0 },
        "model": {
          "refId": "V",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"command.run\"}[6h]))"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": { "refId": "C", "type": "math", "expression": "$A > 0.3 && $B > 0.3 && $V >= 5" }
      }
    ]
  },
  {
    "uid": "rz2-slo-latency-fast-burn",
    "title": "SLO latency fast burn",
    "ruleGroup": "resenhazord2",
    "folderUID": "resenhazord2",
    "condition": "C",
    "for": "2m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "annotations": {
      "summary": "Most commands are taking over 10s",
      "description": "Over 60% of command runs other than ,dl took more than 10s in both the last hour and the last 5 minutes (SLO: 90% under 10s). Needs 3+ runs in the hour."
    },
    "notification_settings": { "receiver": "resenhazord2-email" },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "model": {
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "1 - sum(increase(traces_span_metrics_duration_milliseconds_bucket{span_name=\"command.run\", command_name!=\"dl\", le=\"10000\"}[1h])) / sum(increase(traces_span_metrics_duration_milliseconds_count{span_name=\"command.run\", command_name!=\"dl\"}[1h]))"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 300, "to": 0 },
        "model": {
          "refId": "B",
          "instant": true,
          "range": false,
          "expr": "1 - sum(increase(traces_span_metrics_duration_milliseconds_bucket{span_name=\"command.run\", command_name!=\"dl\", le=\"10000\"}[5m])) / sum(increase(traces_span_metrics_duration_milliseconds_count{span_name=\"command.run\", command_name!=\"dl\"}[5m]))"
        }
      },
      {
        "refId": "V",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "model": {
          "refId": "V",
          "instant": true,
          "range": false,
          "expr": "sum(increase(traces_span_metrics_duration_milliseconds_count{span_name=\"command.run\", command_name!=\"dl\"}[1h]))"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": { "refId": "C", "type": "math", "expression": "$A > 0.6 && $B > 0.6 && $V >= 3" }
      }
    ]
  },
