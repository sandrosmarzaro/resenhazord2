{
  "exchanges": ["resenhazord.commands", "resenhazord.events", "resenhazord.retry"],
  "deadLetterExchange": "resenhazord.dlx",
  "queues": {
    "commands": {},
    "commands.quorum": {
      "x-queue-type": "quorum",
      "x-delivery-limit": 3,
      "x-dead-letter-exchange": "resenhazord.dlx"
    },
    "replies": {},
    "wa_actions": {},
    "wa_rpc": {},
    "group_events": {},
    "commands.dlq": {},
    "commands.retry": {
      "x-message-ttl": 30000,
      "x-dead-letter-exchange": "",
      "x-dead-letter-routing-key": "commands"
    },
    "commands.retry.5s": {
      "x-message-ttl": 5000,
      "x-dead-letter-exchange": "resenhazord.dlx",
      "x-dead-letter-routing-key": "retry.30s"
    },
    "commands.retry.30s": {
      "x-message-ttl": 30000,
      "x-dead-letter-exchange": "resenhazord.dlx",
      "x-dead-letter-routing-key": "retry.2m"
    },
    "commands.retry.2m": {
      "x-message-ttl": 120000,
      "x-dead-letter-exchange": "resenhazord.dlx",
      "x-dead-letter-routing-key": "retry.dead"
    }
  },
  "bindings": [
    {
      "exchange": "resenhazord.commands",
      "pattern": "command.#",
      "queue": "commands"
    },
    {
      "exchange": "resenhazord.commands",
      "pattern": "wa.action.#",
      "queue": "wa_actions"
    },
    {
      "exchange": "resenhazord.commands",
      "pattern": "wa.rpc.#",
      "queue": "wa_rpc"
    },
    {
      "exchange": "resenhazord.events",
      "pattern": "reply.whatsapp",
      "queue": "replies"
    },
    {
      "exchange": "resenhazord.events",
      "pattern": "group.#",
      "queue": "group_events"
    },
    {
      "exchange": "resenhazord.retry",
      "pattern": "commands.quorum",
      "queue": "commands.retry.5s"
    },
    {
      "exchange": "resenhazord.retry",
      "pattern": "retry.30s",
      "queue": "commands.retry.30s"
    },
    {
      "exchange": "resenhazord.retry",
      "pattern": "retry.2m",
      "queue": "commands.retry.2m"
    },
    {
      "exchange": "resenhazord.retry",
      "pattern": "retry.dead",
      "queue": "commands.dlq"
    }
  ],
  "deadLetterRoutes": {
    "rejected": "resenhazord.retry",
    "expired": "commands.quorum",
    "delivery_limit": "commands.dlq"
  }
}
